NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spherex_atlas

STORAGE_PATH=../storage
CONTENT_PATH=../content

ADMIN_PASSWORD=change-me-before-publishing
ADMIN_SESSION_TTL_HOURS=24
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_REVIEW_PER_MINUTE=120

# ---------------------------------------------------------------------------
# NASA data integrations
#
# Every value below has a working default; copy this file to server/.env and
# change only what you need. NASA_API_KEY is NOT set here — it lives in the
# repository-root .env, which both the API and the Python worker read.
# ---------------------------------------------------------------------------

# NASA/IPAC IRSA — SPHEREx discovery (SIA2) and bounded cutouts (IBE).
# No credential required.
IRSA_BASE_URL=https://irsa.ipac.caltech.edu
# One of: spherex_qr3, spherex_qr3_deep, spherex_dr1, spherex_dr1_deep, spherex_dr1_cube
IRSA_COLLECTION=spherex_qr3
IRSA_TIMEOUT_MS=120000
IRSA_CACHE_TTL_SECONDS=86400

# NASA JPL Solar System Dynamics — Horizons, Small-Body Database and
# Small-Body Identification. No credential required.
# Small-Body Identification refines orbits numerically and can take ~30-60 s.
JPL_TIMEOUT_MS=300000
JPL_CACHE_TTL_SECONDS=604800
# MPC observatory code used for ephemerides. 500 is geocentric, which
# approximates SPHEREx's low Earth orbit to well under one 6.15" pixel.
JPL_OBSERVER_CODE=500
# Apparent-magnitude ceiling for identification. Raising it makes JPL refine
# far more orbits per request and can push the call past its timeout.
JPL_VMAG_LIMIT=22
# How close a candidate must be to a JPL position to count as the same object.
JPL_MATCH_TOLERANCE_ARCSEC=60

RATE_LIMIT_ARCHIVE_PER_MINUTE=20
RATE_LIMIT_SOLAR_SYSTEM_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Python science worker
#
# The worker reads this same file, so its knobs live here too.
# ---------------------------------------------------------------------------

# Cutout size per observation, in degrees. 0.12 deg is about 70 SPHEREx pixels
# on a side at 6.15"/pixel: wide enough to register and detect sources, small
# enough to stay a few MB per download.
IRSA_CUTOUT_SIZE_DEG=0.12
IRSA_MAX_CUTOUT_SIZE_DEG=0.5
# How many archive products one FETCH_OBSERVATIONS job materialises.
FETCH_MAX_PRODUCTS=8

MAX_DOWNLOAD=52428800
MAX_CACHE=2147483648
MAX_PIXELS=16777216

JOB_TIMEOUT_SECONDS=300
MAX_JOB_ATTEMPTS=3
